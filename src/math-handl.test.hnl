--- math-handl tests — smoke coverage for the pure-handl `math` port
--- implementations (`src/index.hnl` facade over the per-arrow files).

from "./index" import * as m

test_min_basic := assert m.min(3, 7) == 3
test_min_swapped := assert m.min(7, 3) == 3
test_min_equal := assert m.min(4, 4) == 4

test_max_basic := assert m.max(3, 7) == 7
test_max_swapped := assert m.max(7, 3) == 7

test_abs_neg := assert m.abs(-4) == 4
test_abs_pos := assert m.abs(4) == 4
test_abs_zero := assert m.abs(0) == 0

test_add := assert m.add(2, 3) == 5
test_sub := assert m.sub(5, 3) == 2
test_mul := assert m.mul(4, 3) == 12
test_div := assert m.div(7.0, 2) == 3.5
test_mod := assert m.mod(7, 3) == 1

test_clamp_inside := assert m.clamp(5, 0, 10) == 5
test_clamp_low := assert m.clamp(-1, 0, 10) == 0
test_clamp_high := assert m.clamp(11, 0, 10) == 10

test_lerp_mid := assert m.lerp(0, 10, 0.5) == 5
test_lerp_end := assert m.lerp(0, 10, 1) == 10

test_map_range := assert m.map_range(5, 0, 10, 0, 100) == 50

test_sign_pos := assert m.sign(2) == 1.0
test_sign_neg := assert m.sign(-2) == -1.0
test_sign_zero := assert m.sign(0) == 0.0

test_is_positive := assert m.is_positive(1) == true
test_is_positive_false := assert m.is_positive(-1) == false
test_is_negative := assert m.is_negative(-1) == true
test_is_negative_false := assert m.is_negative(1) == false
test_is_integer := assert m.is_integer(3) == true
test_is_integer_false := assert m.is_integer(3.5) == false
test_is_finite := assert m.is_finite(1) == true
test_is_nan_false := assert m.is_nan(1) == false
